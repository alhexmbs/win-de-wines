# Copiar a .env.local para `vercel dev`. .env.local ya está en .gitignore.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Integración 1 hecha: obtenerReporte() llama a /api/reporte (B) por defecto.
# Ponerlo en 0 solo para volver al reporte mock (demo sin backend).
VITE_REPORTE_REAL=1

# B: opcional. Sin esta key, /api/reporte y probar.ts responden con la
# plantilla de reglas.ts (generado_por:'plantilla') y la demo sigue andando.
ANTHROPIC_API_KEY=

# Multiplica el presupuesto (datos y tiempo) de cada punto de la caminata.
# Vacio o 1 = produccion: 3 MB por punto, para no gastar los datos del cliente.
# Con 3 MB la descarga dura ~1 s a 25 Mbps, y eso no alcanza cuando el usuario
# vuelve de una zona sin senal: la radio del equipo tarda varios segundos en
# recuperar su marcha y el punto sale mas bajo de lo que es.
# En el montaje del evento los archivos salen de una laptop de la misma red, o
# sea que no cuestan datos: ahi conviene 4 (12 MB y hasta 6 s por punto).
VITE_FACTOR_MEDICION=

# Resuelve el envio localmente, sin /api/enviar. Para demos sin backend:
# el flujo llega a la confirmacion con su ticket en vez de morir en un 404.
VITE_ENVIO_REAL=
